        "lint:fix": "oxlint --fix",
        "pretty": "prettier . --write",
        "pretty:check": "prettier . --check"
    },
    "devDependencies": {
        "oxlint": "^1.59.0",
        "prettier": "^3.8.1",
        "terser": "^5.46.1",
        "typescript": "~5.7.3",
        "vite": "^6.4.2"
    },
    "dependencies": {
        "phaser": "^3.90.0"
    }
}
